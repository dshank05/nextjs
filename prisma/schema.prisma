model invoicex {
  id                       Int       @id @default(autoincrement())
  invoice_no               Int
  select_customer          Int?
  items_total              Float?
  freight                  Float?
  total_taxable_value      Float
  taxrate                  Int?
  total_cgst               Float?
  total_sgst               Float?
  total_igst               Float?
  total_tax                Float?
  total                    Float
  notes                    String?   @db.VarChar(255)
  invoice_date             Int
  descriptions             String?   @db.Text
  updated_at               String    @db.VarChar(100)
  payment_status           Int?
  payment_mode             Int?
  fy                       Int
  staff_details            String?   @db.VarChar(255)
  staff_id                 Int?
  commission               Float?
  mechanic_id              Int?
  // Invoice-level fields now stored
