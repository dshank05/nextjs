model salex_return_items {
  id               Int            @id @default(autoincrement())
  salex_return_id  Int
  invoice_itemx_id Int
  return_qty       Float
  return_reason_id Int
  unit_price       Float
  notes            String?        @db.VarChar(255)
  invoice_itemx    invoice_itemsx @relation(fields: [invoice_itemx_id], references: [id], map: "salex_return_items_invoice_itemx_fkey")
  reason           return_reasons @relation(fields: [return_reason_id], references: [id], map: "salex_return_items_reason_fkey")
  salex_return     salex_returns  @relation(fields: [salex_return_id], references: [id], map: "salex_return_items_return_fkey")

  @@index([salex_return_id], map: "salex_return_items_return_fkey")
  @@index([invoice_itemx_id], map: "salex_return_items_invoice_itemx_fkey")
  @@index([return_reason_id], map: "salex_return_items_reason_fkey")
