  payment_mode   Int?                 @default(1)
  payment_date   Int?
  refund_amount  Float?
  created_at     DateTime             @default(now())
  updated_at     DateTime             @updatedAt
  items          salex_return_items[]
  invoicex       invoicex             @relation(fields: [invoicex_id], references: [id], map: "salex_returns_invoicex_fkey")
  customer_refund_allocations customer_refund_allocations[]

  @@index([invoicex_id], map: "salex_returns_invoicex_fkey")
  @@index([status], map: "idx_salex_returns_status")
  @@index([fy, return_date], map: "idx_salex_returns_fy_date")
  @@index([payment_status], map: "idx_salex_returns_payment_status")
