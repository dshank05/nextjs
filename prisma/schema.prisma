}

model return_reasons {
  id                    Int                     @id @default(autoincrement())
  reason_name           String                  @db.VarChar(255)
  type                  String                  @db.VarChar(20)
  status                String                  @default("Active") @db.VarChar(20)
  created_at            DateTime                @default(now())
  updated_at            DateTime                @updatedAt
  purchase_return_items purchase_return_items[]
  sale_return_items     sale_return_items[]
  salex_return_items    salex_return_items[]

  @@index([type], map: "idx_return_reasons_type")
  @@map("return_reasons")
}

model sale_returns {
  id             Int                 @id @default(autoincrement())
  invoice_id     Int
  return_date    Int
  total_amount   Float
  total_tax      Float
  status         String              @default("Pending") @db.VarChar(20)
  notes          String?             @db.Text
  fy             Int
  payment_status Int?                @default(0)
  payment_mode   Int?                @default(1)
  payment_date   Int?
  refund_amount  Float?
  created_at     DateTime            @default(now())
  updated_at     DateTime            @updatedAt
  items          sale_return_items[]
  invoice        Invoice             @relation(fields: [invoice_id], references: [id], map: "sale_returns_invoice_fkey")
  customer_refund_allocations customer_refund_allocations[]

  @@index([invoice_id], map: "sale_returns_invoice_fkey")
  @@index([status], map: "idx_sale_returns_status")
  @@index([fy, return_date], map: "idx_sale_returns_fy_date")
  @@index([payment_status], map: "idx_sale_returns_payment_status")
  @@map("sale_returns")
}

model sale_return_items {
  id               Int            @id @default(autoincrement())
  sale_return_id   Int
  invoice_item_id  Int
  return_qty       Float
  return_reason_id Int
  unit_price       Float
  tax_amount       Float
  notes            String?        @db.VarChar(255)
  invoice_item     Invoiceitems   @relation(fields: [invoice_item_id], references: [id], map: "sale_return_items_invoice_item_fkey")
  reason           return_reasons @relation(fields: [return_reason_id], references: [id], map: "sale_return_items_reason_fkey")
  sale_return      sale_returns   @relation(fields: [sale_return_id], references: [id], map: "sale_return_items_return_fkey")

  @@index([sale_return_id], map: "sale_return_items_return_fkey")
  @@index([invoice_item_id], map: "sale_return_items_invoice_item_fkey")
  @@index([return_reason_id], map: "sale_return_items_reason_fkey")
  @@map("sale_return_items")
}

model purchase_returns {
  id                         Int                     @id @default(autoincrement())
  debit_note_no              String?                 @db.VarChar(50)
  note_type                  String?                 @default("DEBIT") @db.VarChar(20)
  vendor_id                  Int?                    // Vendor-based returns (nullable for existing data)
  purchase_id                Int?                    // Nullable for vendor-based returns
  return_date                Int
  total_amount               Float
  total_tax                  Float
  status                     Int                     @default(1)
  notes                      String?                 @db.Text
  fy                         Int
  payment_status             Int?                    @default(0) // 0=Unpaid/Pending Refund, 1=Paid/Refunded
  payment_mode               Int?                    @default(1) // 0=Cash, 1=Bank
  payment_date               Int?                    // Unix timestamp when refund received
  refund_amount              Float?                  // Total refund amount
  include_packing_forwarding Int?                    @default(0) @db.TinyInt
  include_freight            Int?                    @default(0) @db.TinyInt
  pf_calculation_method      Int?                    @default(3) @db.TinyInt
  freight_calculation_method Int?                    @default(3) @db.TinyInt
  packing_forwarding_amount  Decimal?                @default(0) @db.Decimal(10, 2)
  freight_amount             Decimal?                @default(0) @db.Decimal(10, 2)
  created_at                 DateTime                @default(now())
  updated_at                 DateTime                @updatedAt
  items                      purchase_return_items[]
  refund_allocations         refund_allocations[]
  vendor                     vendor_details?         @relation(fields: [vendor_id], references: [id], map: "purchase_returns_vendor_fkey")
  purchase                   Purchase?               @relation(fields: [purchase_id], references: [id], map: "purchase_returns_purchase_fkey")

  @@index([vendor_id], map: "purchase_returns_vendor_fkey")
  @@index([purchase_id], map: "purchase_returns_purchase_fkey")
  @@index([status], map: "idx_purchase_returns_status")
  @@index([fy], map: "idx_purchase_returns_fy")
  @@index([payment_status], map: "idx_purchase_returns_payment_status")
  @@index([debit_note_no], map: "idx_purchase_returns_debit_note")
  @@map("purchase_returns")
}

model purchase_return_items {
  id                 Int              @id @default(autoincrement())
  purchase_return_id Int
  purchase_item_id   Int
  return_qty         Float
  return_reason_id   Int
  unit_price         Float
  tax_amount         Float
  cgst               Float?           // Tax breakdown for GST compliance
  sgst               Float?           // Tax breakdown for GST compliance
  igst               Float?           // Tax breakdown for GST compliance
  notes              String?          @db.VarChar(255)
  purchase_item      Purchaseitems    @relation(fields: [purchase_item_id], references: [id], map: "purchase_return_items_purchase_item_fkey")
  reason             return_reasons   @relation(fields: [return_reason_id], references: [id], map: "purchase_return_items_reason_fkey")
  purchase_return    purchase_returns @relation(fields: [purchase_return_id], references: [id], map: "purchase_return_items_return_fkey")

  @@index([purchase_return_id], map: "purchase_return_items_return_fkey")
  @@index([purchase_item_id], map: "purchase_return_items_purchase_item_fkey")
  @@index([return_reason_id], map: "purchase_return_items_reason_fkey")
  @@map("purchase_return_items")
}

model salex_returns {
  id             Int                  @id @default(autoincrement())
  invoicex_id    Int
  return_date    Int
  total_amount   Float
  status         String               @default("Pending") @db.VarChar(20)
  notes          String?              @db.Text
