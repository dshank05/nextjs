generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Adminu {
  id                   Int     @id @default(autoincrement())
  name                 String? @db.VarChar(200)
  contactperson        String? @db.VarChar(200)
  gender               Int?
  username             String? @db.VarChar(255)
  auth_key             String  @db.VarChar(32)
  password_hash        String  @db.VarChar(255)
  password_reset_token String? @db.VarChar(255)
  email                String  @db.VarChar(255)
  mobile               String? @db.VarChar(10)
  status               Int     @default(10) @db.SmallInt
  role                 Int?
  address              String? @db.VarChar(200)
  created_at           Int
  updated_at           Int

  @@map("adminu")
}

model Settings {
  id        Int @id @default(autoincrement())
  currentfy Int

  @@map("settings")
}

model States {
  id         Int    @id @default(autoincrement())
  state_name String @db.VarChar(100)
  code       Int

  @@index([state_name], map: "idx_states_name")
  @@map("states")
}

model Product {
  id                     Int                  @id @default(autoincrement())
  product_name           String               @db.VarChar(255)
  display_name           String?              @db.VarChar(255)
  hsn                    String?              @db.VarChar(50)
  product_category_id    Int?
  product_subcategory_id Int?
  car_model_ids          String?
  pic                    String?              @db.VarChar(255)
  barcode                String?              @db.VarChar(100)
  part_no                String?              @unique @db.VarChar(100)
  min_stock              Int?
  stock                  Int?
  opening_rate           Float?
  notes                  String?              @db.VarChar(255)
  warehouse_id           Int?
  gst_rate_id            Int?
  opening_stock          Int?
  is_active              Boolean              @default(true)
  descriptions           String?              @db.Text
  discount               Float?
  margin                 Float?
  mrp                    Float?
  rack_number            String?              @db.VarChar(100)
  rack_id                Int?
  company_id             Int?
  last_purchase_date     Int?
  latest_purchase_rate   Float?
  invoice_items          Invoiceitems[]
  invoice_itemsx         invoice_itemsx[]
  category_ref           product_category?    @relation(fields: [product_category_id], references: [id], map: "product_category_fkey")
  product_company_ref    product_company?     @relation(fields: [company_id], references: [id], map: "product_company_fkey")
  gst_rate               gst_tax_rate?        @relation(fields: [gst_rate_id], references: [id], map: "product_gst_rate_fkey")
  rack                   warehouse_racks?     @relation(fields: [rack_id], references: [id], map: "product_rack_fkey")
  subcategory_ref        product_subcategory? @relation(fields: [product_subcategory_id], references: [id], map: "product_subcategory_fkey")
  warehouse              warehouse?           @relation(fields: [warehouse_id], references: [id], map: "product_warehouse_fkey")
  deadstock_entries      deadstock[]          // Deadstock entries for this product

  @@index([product_name], map: "idx_product_name")
  @@index([part_no], map: "idx_product_part_no")
  @@index([stock, min_stock], map: "idx_product_stock")
  @@index([mrp], map: "idx_product_mrp")
  @@index([is_active], map: "idx_product_active")
  @@index([product_category_id, is_active, product_name], map: "idx_product_category_active_name")
  @@index([product_category_id], map: "product_category_fkey")
  @@index([gst_rate_id], map: "product_gst_rate_fkey")
  @@index([rack_id], map: "product_rack_fkey")
  @@index([product_subcategory_id], map: "product_subcategory_fkey")
  @@index([warehouse_id], map: "product_warehouse_fkey")
  @@index([company_id], map: "product_company_fkey")
  @@map("product")
}

model Invoice {
  id                       Int            @id @default(autoincrement())
  invoice_no               Int
  select_customer          Int
  items_total              Float?
  freight                  Float?
  total_taxable_value      Float
  taxrate                  Int?
  total_cgst               Float?
  total_sgst               Float?
  total_igst               Float?
  total_tax                Float?
  total                    Float
  notes                    String?        @db.VarChar(255)
  invoice_date             Int
  updated_at               String         @db.VarChar(100)
  payment_mode             Int?
  fy                       Int
  staff_details            String?        @db.VarChar(255)
  staff_id                 Int?
  commission               Float?
  mechanic_id              Int?
  bill_reference           String?        @db.VarChar(255)
  descriptions             String?        @db.Text
  discount                 Float?
  packing_forwarding_qty   Float?
  packing_forwarding_rate  Float?
  packing_forwarding_total Float?
  discount_percentage      Float?
  payment_status           Int?
  return_status            Int?           @default(0)
  mechanic                 mechanic?      @relation(fields: [mechanic_id], references: [id], map: "invoice_mechanic_fkey")
  staff                    staff?         @relation(fields: [staff_id], references: [id], map: "invoice_staff_fkey")
  sale_returns             sale_returns[]
  customer_payment_allocations customer_payment_allocations[]

  @@index([mechanic_id], map: "invoice_mechanic_fkey")
  @@index([staff_id], map: "invoice_staff_fkey")
  @@index([invoice_date], map: "idx_invoice_invoice_date")
  @@index([payment_status], map: "idx_invoice_status")
  @@index([fy, invoice_date], map: "idx_invoice_fy_date")
  @@index([return_status], map: "idx_invoice_return_status")
  @@map("invoice")
}

model Invoiceitems {
  id                Int                 @id @default(autoincrement())
  invoice_no        Int
  name_of_product   String              @db.VarChar(255)
  category_id       Int?
  model_id          Int?
  company_id        Int?
  hsn               String?             @db.VarChar(50)
  part              String?             @db.VarChar(100)
  qty               Float?
  rate              Float?
  subtotal          Float
  invoice_date      Int
  fy                Int
  product_id        Int
  cgst              Float?
  gst_percentage    Float?
  igst              Float?
  sgst              Float?
  tax               Float?
  discount          Float?
  discountrate      Float?
  subcategory_id    Int?
  product           Product             @relation(fields: [product_id], references: [id], map: "invoiceitems_product_fkey")
  sale_return_items sale_return_items[]

  @@index([invoice_date], map: "idx_invoiceitems_invoice_date")
  @@index([product_id], map: "invoiceitems_product_fkey")
  @@map("invoice_items")
}

model Purchase {
  id                       Int                @id @default(autoincrement())
  invoice_no               Int
  bill_reference           String?            @db.VarChar(255)
  bill_reference_date      DateTime?          @db.DateTime
  vendor_id                Int?
  items_total              Float?
  freight                  Float?
  total_taxable_value      Float
  taxrate                  Int?
  total_cgst               Float?
  total_sgst               Float?
  total_igst               Float?
  total_tax                Float?
  total                    Float
  notes                    String?            @db.VarChar(255)
  descriptions             String?            @db.Text
  packing_forwarding_qty   Float?
  packing_forwarding_rate  Float?
  packing_forwarding_total Float?
  basic_value              Float?
  bill                     String?            @db.VarChar(255)
  tax                      String?            @db.VarChar(255)
  invoice_date             Int
  updated_at               String             @db.VarChar(100)
  payment_mode             Int?
  transport                String?            @db.VarChar(255)
  transport_name           String?            @db.VarChar(255)
  vehicle_number           String?            @db.VarChar(100)
  fy                       Int
  payment_status           Int?
  staff_id                 Int?
  return_status            Int?               @default(0)
  staff                    staff?                  @relation(fields: [staff_id], references: [id])
  vendor                   vendor_details?         @relation(fields: [vendor_id], references: [id], map: "purchase_vendor_fkey")
  purchase_returns         purchase_returns[]
  payment_allocations      payment_allocations[]

  @@index([invoice_date], map: "idx_purchase_invoice_date")
  @@index([payment_status], map: "idx_purchase_payment_status")
  @@index([payment_status, fy, invoice_date], map: "idx_purchase_payment_status_fy_date")
  @@index([staff_id], map: "purchase_staff_id_fkey")
  @@index([vendor_id], map: "purchase_vendor_fkey")
  @@map("purchase")
}

model Purchaseitems {
  id                    Int                     @id @default(autoincrement())
  invoice_no            Int
  name_of_product       String                  @db.VarChar(255)
  category_id           Int?
  subcategory_id        Int?
  model_id              Int?
  company_id            Int?
  car_model             String?                 @db.VarChar(255)
  vendor_id             Int?
  hsn                   String?                 @db.VarChar(50)
  part                  String?                 @db.VarChar(100)
  qty                   Float?
  rate                  Float?
  subtotal              Float
  fy                    Int
  invoice_date          Int
  product_id            Int?
  cgst                  Float?
  gst_percentage        Float?
  igst                  Float?
  sgst                  Float?
  tax                   Float?
  purchase_return_items purchase_return_items[]

  @@index([name_of_product, invoice_date(sort: Desc)], map: "idx_purchase_items_product_date")
  @@index([invoice_no, product_id], map: "idx_purchase_items_invoice_product")
  @@index([product_id], map: "idx_purchase_items_product_id")
  @@index([invoice_no], map: "idx_purchase_items_invoice_no")
  @@map("purchase_items")
}

model Incexp {
  id           Int     @id @default(autoincrement())
  invoice_id   Int?
  user_id      Int
  amt          Float
  payment_mode Int
  type         Int?
  incexp_date  String  @db.VarChar(30)
  fy           Int?
  notes        String? @db.VarChar(100)

  @@index([incexp_date], map: "idx_incexp_date")
  @@index([type], map: "idx_incexp_type")
  @@index([user_id], map: "idx_incexp_user_id")
  @@map("incexp")
}

model bank_details {
  id             Int     @id @default(autoincrement())
  bank_name      String  @db.VarChar(200)
  account_number String  @db.VarChar(100)
  bank_address   String? @db.VarChar(255)
  ifsc           String? @db.VarChar(30)

  @@index([bank_name], map: "idx_bank_details_name")
}

model bill_to {
  id          Int     @id @default(autoincrement())
  invoice_no  Int?    @unique
  vendor_name String  @db.VarChar(255)
  contact_no  String? @db.VarChar(20)
  email       String? @db.VarChar(100)
  address     String  @db.VarChar(255)
  address2    String? @db.VarChar(255)
  city        String? @db.VarChar(100)
  state       String? @db.VarChar(100)
  state_code  Int?
  pin_code    String? @db.VarChar(20)
  gstin       String? @db.VarChar(50)
}

model bill_tosales {
  id                 Int     @id @default(autoincrement())
  invoice_no         Int?    @unique
  billing_name       String  @db.VarChar(200)
  contact_no         String? @db.VarChar(20)
  email              String? @db.VarChar(100)
  billing_address    String  @db.VarChar(255)
  billing_address2   String? @db.VarChar(255)
  billing_city       String? @db.VarChar(100)
  billing_state      String? @db.VarChar(100)
  billing_state_code Int?
  billing_gstin      String? @db.VarChar(30)
}

model bill_tosalesx {
  id                 Int     @id @default(autoincrement())
  invoice_no         Int?    @unique
  billing_name       String  @db.VarChar(200)
  contact_no         String? @db.VarChar(20)
  email              String? @db.VarChar(100)
  billing_address    String  @db.VarChar(255)
  billing_address2   String? @db.VarChar(255)
  billing_city       String? @db.VarChar(100)
  billing_state      String? @db.VarChar(100)
  billing_state_code Int?
  billing_gstin      String? @db.VarChar(30)
}

model business_details {
  id             Int     @id @default(autoincrement())
  gstin          String  @db.VarChar(50)
  name           String  @db.VarChar(255)
  tagline        String? @db.VarChar(255)
  address_line_1 String  @db.VarChar(255)
  address_line_2 String? @db.VarChar(255)
  pin_code       String? @db.VarChar(20)
  phone          String? @db.VarChar(100)
  phone2         String? @db.VarChar(100)
  email          String? @db.VarChar(255)
  fax            String? @db.VarChar(30)
  terms          String? @db.Text
}

model customer_details {
  id                      Int       @id @default(autoincrement())
  billing_name            String    @db.VarChar(200)
  billing_address         String    @db.VarChar(255)
  billing_address_2       String?   @db.VarChar(255)
  billing_city            String?   @db.VarChar(100)
  billing_pin_code        String?   @db.VarChar(20)
  billing_state           String?   @db.VarChar(100)
  billing_state_code      Int?
  billing_gstin           String?   @db.VarChar(30)
  contact_no              String?   @db.VarChar(20)
  contact_no_2            String?   @db.VarChar(20)
  contact_no_3            String?   @db.VarChar(20)
  email                   String?   @db.VarChar(100)
  status                  String    @default("Active") @db.VarChar(20)
  shipping_name           String?   @db.VarChar(200)
  shipping_address        String    @db.VarChar(255)
  shipping_address_2      String?   @db.VarChar(255)
  shipping_city           String?   @db.VarChar(100)
  shipping_pin_code       String?   @db.VarChar(20)
  shipping_state          String?   @db.VarChar(100)
  shipping_state_code     Int?
  shipping_gstin          String?   @db.VarChar(30)
  account_balance         Decimal   @default(0) @db.Decimal(10, 2)
  total_paid              Decimal   @default(0) @db.Decimal(10, 2)
  total_allocated         Decimal   @default(0) @db.Decimal(10, 2)
  total_refunded          Decimal   @default(0) @db.Decimal(10, 2)
  total_refund_allocated  Decimal   @default(0) @db.Decimal(10, 2)
  balance_updated_at      DateTime? @updatedAt
  customer_payments       customer_payments[]
  customer_refunds        customer_refunds[]
}

model financial_year {
  id         Int       @id @default(autoincrement())
  fy         String    @db.VarChar(30)
  start_date DateTime? @db.Date
  end_date   DateTime? @db.Date

  @@index([fy], map: "idx_financial_year_fy")
}

model incexpx {
  id           Int     @id @default(autoincrement())
  invoice_id   Int?
  user_id      Int
  amt          Float
  payment_mode Int
  type         Int?
  incexp_date  String  @db.VarChar(30)
  fy           Int?
  notes        String? @db.VarChar(100)

  @@index([incexp_date], map: "idx_incexpx_date")
  @@index([type], map: "idx_incexpx_type")
  @@index([user_id], map: "idx_incexpx_user_id")
}

model invoice_itemsx {
  id                 Int                  @id @default(autoincrement())
  invoice_no         Int
  name_of_product    String               @db.VarChar(255)
  category_id        Int?
  model_id           Int?
  company_id         Int?
  hsn                String?              @db.VarChar(50)
  part               String?              @db.VarChar(100)
  qty                Float?
  rate               Float?
  subtotal           Float
  invoice_date       Int
  fy                 Int
  product_id         Int
  cgst               Float?
  gst_percentage     Float?
  igst               Float?
  sgst               Float?
  tax                Float?
  discount           Float?
  discountrate       Float?
  subcategory_id     Int?
  product            Product              @relation(fields: [product_id], references: [id], map: "invoiceitemsx_product_fkey")
  salex_return_items salex_return_items[]

  @@index([invoice_date], map: "idx_invoice_itemsx_invoice_date")
  @@index([product_id], map: "invoiceitemsx_product_fkey")
}

model invoicex {
  id                       Int             @id @default(autoincrement())
  invoice_no               Int
  select_customer          Int?
  items_total              Float?
  freight                  Float?
  total_taxable_value      Float
  taxrate                  Int?
  total_cgst               Float?
  total_sgst               Float?
  total_igst               Float?
  total_tax                Float?
  total                    Float
  notes                    String?         @db.VarChar(255)
  invoice_date             Int
  updated_at               String          @db.VarChar(100)
  payment_mode             Int?
  fy                       Int
  staff_details            String?         @db.VarChar(255)
  staff_id                 Int?
  commission               Float?
  mechanic_id              Int?
  descriptions             String?         @db.Text
  packing_forwarding_qty   Float?
  packing_forwarding_rate  Float?
  packing_forwarding_total Float?
  bill_reference           String?         @db.VarChar(255)
  discount                 Float?
  payment_status           Int?
  return_status            Int?            @default(0)
  mechanic                 mechanic?       @relation(fields: [mechanic_id], references: [id], map: "invoicex_mechanic_fkey")
  staff                    staff?          @relation(fields: [staff_id], references: [id], map: "invoicex_staff_fkey")
  salex_returns            salex_returns[]
  customer_payment_allocations customer_payment_allocations[]

  @@index([mechanic_id], map: "invoicex_mechanic_fkey")
  @@index([staff_id], map: "invoicex_staff_fkey")
  @@index([invoice_date], map: "idx_invoicex_invoice_date")
  @@index([payment_status], map: "idx_invoicex_status")
  @@index([return_status], map: "idx_invoicex_return_status")
}

model migration {
  version    String @id @db.VarChar(180)
  apply_time Int?
}

model product_category {
  id            Int                   @id @default(autoincrement())
  category_name String                @db.VarChar(255)
  products      Product[]
  subcategories product_subcategory[]

  @@index([category_name], map: "idx_product_category_name")
  @@map("product_category")
}

model product_subcategory {
  id               Int              @id @default(autoincrement())
  subcategory_name String           @db.VarChar(255)
  category_id      Int
  products         Product[]
  category         product_category @relation(fields: [category_id], references: [id])

  @@index([category_id], map: "idx_product_subcategory_category_id")
  @@index([subcategory_name], map: "idx_product_subcategory_name")
  @@map("product_subcategory")
}

model car_models {
  id         Int    @id @default(autoincrement())
  model_name String @db.VarChar(255)

  @@index([model_name], map: "idx_car_models_name")
  @@map("car_models")
}

model product_company {
  id           Int       @id @default(autoincrement())
  company_name String    @db.VarChar(255)
  products     Product[]

  @@index([company_name], map: "idx_product_company_name")
}

model shipto {
  id                  Int     @id @default(autoincrement())
  invoice_no          Int?    @unique
  shipping_name       String? @db.VarChar(200)
  shipping_address    String  @db.VarChar(255)
  shipping_address2   String? @db.VarChar(255)
  shipping_city       String? @db.VarChar(100)
  shipping_state      String? @db.VarChar(100)
  shipping_state_code Int?
  shipping_gstin      String? @db.VarChar(30)
  shipping            Boolean @default(false)
}

model shiptox {
  id                  Int     @id @default(autoincrement())
  invoice_no          Int?    @unique
  shipping_name       String? @db.VarChar(200)
  shipping_address    String  @db.VarChar(255)
  shipping_address2   String? @db.VarChar(255)
  shipping_city       String? @db.VarChar(100)
  shipping_state      String? @db.VarChar(100)
  shipping_state_code Int?
  shipping_gstin      String? @db.VarChar(30)
  shipping            Boolean @default(false)
}

model transport_details {
  id          Int     @id @default(autoincrement())
  invoice_id  Int     @unique
  trans_mode  String? @db.VarChar(100)
  vehicle_no  String? @db.VarChar(100)
  supply_date String? @db.VarChar(100)
}

model transport_detailsx {
  id          Int     @id @default(autoincrement())
  invoice_id  Int     @unique
  trans_mode  String? @db.VarChar(100)
  vehicle_no  String? @db.VarChar(100)
  supply_date String? @db.VarChar(100)
}

model user {
  id                   Int     @id @default(autoincrement())
  username             String  @unique(map: "username") @db.VarChar(255)
  auth_key             String  @db.VarChar(32)
  password_hash        String  @db.VarChar(255)
  password_reset_token String? @unique(map: "password_reset_token") @db.VarChar(255)
  email                String  @unique(map: "email") @db.VarChar(255)
  phone                String? @db.VarChar(10)
  status               Int     @default(10) @db.SmallInt
  created_at           Int
  updated_at           Int

  @@index([username], map: "idx_user_username")
  @@index([email], map: "idx_user_email")
  @@index([phone], map: "idx_user_phone")
  @@index([status], map: "idx_user_status")
}

model vendor_details {
  id                      Int       @id @default(autoincrement())
  vendor_name             String    @db.VarChar(255)
  address                 String?   @db.VarChar(255)
  address_2               String?   @db.VarChar(255)
  city                    String?   @db.VarChar(100)
  pin_code                String?   @db.VarChar(20)
  state                   String?
  state_code              Int?
  contact_no              String?   @db.VarChar(20)
  contact_no_2            String?   @db.VarChar(20)
  contact_no_3            String?   @db.VarChar(20)
  email                   String?   @db.VarChar(100)
  status                  String    @default("Active") @db.VarChar(20)
  tax_id                  String?   @db.VarChar(50)
  account_balance         Decimal   @default(0) @db.Decimal(10, 2)
  total_paid              Decimal   @default(0) @db.Decimal(10, 2)
  total_allocated         Decimal   @default(0) @db.Decimal(10, 2)
  total_refunded          Decimal   @default(0) @db.Decimal(10, 2)
  total_refund_allocated  Decimal   @default(0) @db.Decimal(10, 2)
  balance_updated_at      DateTime? @updatedAt
  purchases               Purchase[]
  returns                 purchase_returns[]
  payments                vendor_payments[]
  refunds                 vendor_refunds[]
  balance_logs            vendor_balance_logs[]

  @@index([vendor_name], map: "idx_vendor_name")
  @@index([contact_no], map: "idx_vendor_contact_no")
  @@index([email], map: "idx_vendor_email")
  @@index([status], map: "idx_vendor_status")
  @@index([account_balance], map: "idx_vendor_balance")
}

model warehouse_racks {
  id           Int       @id @default(autoincrement())
  warehouse_id Int
  rack_number  String    @db.VarChar(50)
  description  String?   @db.VarChar(255)
  status       String    @default("Active") @db.VarChar(20)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  products     Product[]
  warehouse    warehouse @relation(fields: [warehouse_id], references: [id])

  @@unique([warehouse_id, rack_number], map: "unique_warehouse_rack")
  @@index([warehouse_id], map: "warehouse_racks_warehouse_id_fkey")
  @@map("warehouse_racks")
}

model warehouse {
  id       Int               @id @default(autoincrement())
  name     String            @db.VarChar(255)
  location String            @db.VarChar(255)
  status   String            @default("Active") @db.VarChar(50)
  products Product[]
  racks    warehouse_racks[]

  @@index([name], map: "idx_warehouse_name")
  @@index([location], map: "idx_warehouse_location")
  @@index([status], map: "idx_warehouse_status")
  @@index([status, name], map: "idx_warehouse_status_name")
  @@map("warehouse")
}

model gst_tax_rate {
  id             Int       @id @default(autoincrement())
  description    String    @db.VarChar(255)
  rate           Float
  hsn_code       String    @db.VarChar(50)
  applicable_for String    @db.Text
  status         String    @default("Active") @db.VarChar(20)
  products       Product[]

  @@index([description], map: "idx_gst_tax_rate_description")
  @@index([hsn_code], map: "idx_gst_tax_rate_hsn_code")
  @@index([status], map: "idx_gst_tax_rate_status")
  @@index([status, description], map: "idx_gst_status_description")
  @@map("gst_tax_rate")
}

model staff {
  id         Int        @id @default(autoincrement())
  name       String     @db.VarChar(255)
  email      String?    @db.VarChar(255)
  phone      String     @db.VarChar(20)
  status     String     @default("Active") @db.VarChar(20)
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  invoices   Invoice[]
  invoicexs  invoicex[]
  purchases  Purchase[]

  @@index([name], map: "idx_staff_name")
  @@index([phone], map: "idx_staff_phone")
  @@index([status], map: "idx_staff_status")
  @@map("staff")
}

model mechanic {
  id         Int        @id @default(autoincrement())
  name       String     @db.VarChar(255)
  phone      String     @db.VarChar(20)
  city       String?    @db.VarChar(50)
  status     String     @default("Active") @db.VarChar(20)
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  invoices   Invoice[]
  invoicexs  invoicex[]

  @@index([name], map: "idx_mechanic_name")
  @@index([phone], map: "idx_mechanic_phone")
  @@index([status], map: "idx_mechanic_status")
  @@index([city], map: "idx_mechanic_city")
